{
  "name": "icarex-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "postinstall": "pnpm run install:client",
    "install:client": "pnpm --dir src/iCareX.Web/iCareX.Web.Client install --frozen-lockfile",
    "dev": "pnpm --dir src/iCareX.Web/iCareX.Web.Client dev",
    "build": "pnpm --dir src/iCareX.Web/iCareX.Web.Client build",
    "test": "pnpm --dir src/iCareX.Web/iCareX.Web.Client test",
    "typecheck": "pnpm --dir src/iCareX.Web/iCareX.Web.Client typecheck",
    "preview": "pnpm --dir src/iCareX.Web/iCareX.Web.Client preview",
    "format": "pnpm --dir src/iCareX.Web/iCareX.Web.Client format",
    "contracts:generate": "python tools/contracts/generate_typescript.py",
    "contracts:check": "python tools/contracts/generate_typescript.py --check"
  }
}
